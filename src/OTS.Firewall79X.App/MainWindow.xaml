<Window x:Class="OTS.Firewall79X.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OTS Firewall79X" Icon="Assets/AppIcon.ico" Width="1360" Height="850" MinWidth="1040" MinHeight="670" Background="#0F172A" FontFamily="Segoe UI" FontSize="14" Foreground="#FFFFFF">
<DockPanel Margin="22">
<Border DockPanel.Dock="Top" Style="{StaticResource SurfaceCard}" Padding="18,14" Margin="0,0,0,18" Background="#15243B">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Border Width="72" Height="72" CornerRadius="12" Background="#0F172A" Padding="7" BorderBrush="#34587C" BorderThickness="1">
   <Image Source="Assets/AppLogo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
  </Border>
  <StackPanel Grid.Column="1" Margin="16,3,0,0" VerticalAlignment="Center">
   <TextBlock Text="OHANA TECH SOLUTIONS" Foreground="#8BA8CD" FontSize="11" FontWeight="SemiBold"/>
   <TextBlock Text="OTS Firewall79X" Foreground="#FFFFFF" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/>
   <TextBlock Text="Layered security • real-time visibility • reversible actions" Foreground="#B4C8DE" Margin="0,4,0,0"/>
  </StackPanel>
  <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#26364F"
   BorderBrush="#34587C" BorderThickness="1" CornerRadius="12" Padding="14,9">
   <StackPanel><TextBlock Text="DEVELOPMENT PREVIEW" FontWeight="SemiBold" FontSize="11" Foreground="#F2D08D" HorizontalAlignment="Center"/>
   <TextBlock Text="v0.1.0 · capabilities in progress" Foreground="#C8D7E9" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
  </Border>
 </Grid>
</Border>
<Border DockPanel.Dock="Bottom" Background="#18263C" CornerRadius="12" Padding="12,9" Margin="0,14,0,0">
 <TextBlock x:Name="StatusLine" TextWrapping="Wrap" Foreground="#B4C8DE" Text="Connecting to local security service…"/>
</Border>
<TabControl Background="#0F172A" BorderThickness="0">
<TabItem Header="Dashboard">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="8,18,8,12">
   <Border Style="{StaticResource SurfaceCard}" Background="#18283F" Padding="24">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" Margin="0,0,22,0">
      <TextBlock Text="PROTECTION OVERVIEW" FontSize="12" Foreground="#8BA8CD" FontWeight="SemiBold"/>
      <TextBlock x:Name="ProtectionText" Text="Checking local service…" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,12"/>
      <TextBlock Text="Development preview: the displayed health score measures observed capabilities, not a guarantee of protection. Unavailable defenses remain disclosed." TextWrapping="Wrap" Foreground="#B4C8DE" MaxWidth="610" Margin="0,0,0,22"/>
      <WrapPanel>
       <Button x:Name="Toggle" Content="Turn ON" Click="ToggleClick" Style="{StaticResource PrimaryButton}" MinWidth="158"/>
       <Button Content="Pause 15 minutes" Click="PauseClick"/>
       <Button Content="Refresh status" Click="RefreshClick"/>
      </WrapPanel>
      <TextBlock Text="Security features remain subject to system permissions and the local service status." FontSize="12" Foreground="#8BA8CD" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </StackPanel>
     <Border Grid.Column="1" Background="#101D33" CornerRadius="12" Padding="18"
      BorderThickness="1" BorderBrush="#34587C" MinWidth="210">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
       <Canvas Width="124" Height="124">
        <Ellipse Canvas.Left="5" Canvas.Top="5" Width="114" Height="114" Fill="#182B47" Stroke="#4E79A7" StrokeThickness="3">
         <Ellipse.Effect><DropShadowEffect Color="#4E79A7" BlurRadius="20" ShadowDepth="0" Opacity=".6"/></Ellipse.Effect>
        </Ellipse>
        <Path Data="M 62,22 L 99,39 V 67 C 99,90 82,106 62,114 C 42,106 25,90 25,67 V 39 Z"
         Fill="#24405E" Stroke="#8BA8CD" StrokeThickness="3"/>
        <Path Data="M 46,67 L 58,78 L 80,53" Fill="Transparent" Stroke="#EBC270" StrokeThickness="7"
         StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
       </Canvas>
       <TextBlock Text="SERVICE STATUS" FontWeight="SemiBold" Foreground="#8BA8CD" FontSize="11" TextAlignment="Center" Margin="0,10,0,5"/>
       <TextBlock Text="Verify telemetry below" FontSize="13" TextAlignment="Center" Foreground="#FFFFFF"/>
       <TextBlock Text="No unsupported safety claims" Foreground="#A5BEDB" FontSize="11" TextAlignment="Center" Margin="0,5,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
   <UniformGrid Columns="3" Margin="0,14,0,0">
    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,7,0">
     <StackPanel>
      <TextBlock Text="CAPABILITY HEALTH" Foreground="#8BA8CD" FontSize="12" FontWeight="SemiBold"/>
      <TextBlock x:Name="ScoreText" Text="— / 100" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,6"/>
      <TextBlock x:Name="ConfidenceText" TextWrapping="Wrap" Foreground="#BED0E4" FontSize="12"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource SurfaceCard}" Margin="7,0">
     <StackPanel>
      <TextBlock Text="CONFIRMED OTS BLOCKS" Foreground="#8BA8CD" FontSize="12" FontWeight="SemiBold"/>
      <TextBlock x:Name="BlockedText" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,6"/>
      <TextBlock Text="Not attributed from Windows-only blocks" TextWrapping="Wrap" Foreground="#BED0E4" FontSize="12"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource SurfaceCard}" Margin="7,0,0,0">
     <StackPanel>
      <TextBlock Text="SECURITY EVENTS" Foreground="#8BA8CD" FontSize="12" FontWeight="SemiBold"/>
      <TextBlock x:Name="EventCountText" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,6"/>
      <TextBlock Text="Counters observed since service start" Foreground="#BED0E4" FontSize="12" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </UniformGrid>
   <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
    <StackPanel>
     <TextBlock Text="LIVE HEALTH &amp; ACTIVITY" FontSize="12" Foreground="#8BA8CD" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock x:Name="ResourceText" TextWrapping="Wrap" Foreground="#DCE8F6"/>
     <TextBlock x:Name="FeedText" TextWrapping="Wrap" Foreground="#DCE8F6" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0" Background="#1B283E">
    <StackPanel>
     <TextBlock Text="CAPABILITY LIMITATIONS" Foreground="#EBC270" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock x:Name="HealthSummary" TextWrapping="Wrap" Foreground="#E2EAF4"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</TabItem>
<TabItem Header="Security Layers"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="SEARCH SECURITY LAYERS" FontSize="12" FontWeight="SemiBold" Foreground="#8BA8CD" Margin="0,0,0,8"/><TextBox x:Name="LayerSearch" TextChanged="LayerSearchChanged" ToolTip="Filter by layer name, category, evidence, or ID"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Margin="0,10" Text="Elapsed time is measured per check; shared memory cannot be accurately assigned to individual layers." TextWrapping="Wrap"/><DataGrid x:Name="LayerGrid" SelectionChanged="LayerSelected"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40"/><DataGridTextColumn Header="Layer" Binding="{Binding Name}" Width="260"/><DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="100"/><DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="100"/><DataGridTextColumn Header="Evidence / limitation" Binding="{Binding Evidence}" Width="*"/><DataGridTextColumn Header="ms" Binding="{Binding Duration}" Width="65"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="Threat Activity"><DataGrid x:Name="EventGrid" Margin="12"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="170"/><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/><DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="55"/><DataGridTextColumn Header="Event" Binding="{Binding Kind}" Width="210"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
<TabItem Header="Network"><DataGrid x:Name="NetworkGrid" Margin="12"><DataGrid.Columns><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/><DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="160"/><DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="*"/><DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
<TabItem Header="Tools &amp; Reports"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="Reports and user-authorized checks" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Exports may contain process names, connection addresses, and file locations. Keep them private." TextWrapping="Wrap" Margin="0,10,0,20"/><WrapPanel><Button Content="Save security report" Click="ReportClick"/><Button Content="Scan folder for exposed secrets" Click="SecretsClick"/><Button Content="Run local self-check" Click="SelfTestClick"/></WrapPanel><TextBlock Text="Password breach check (optional)" FontSize="18" Margin="0,20,0,8"/><TextBlock Text="Only the first five characters of a SHA-1 hash are sent to the Pwned Passwords range service. The password is not saved." TextWrapping="Wrap"/><PasswordBox x:Name="BreachPassword" MaxLength="1024" Width="360" HorizontalAlignment="Left" Margin="0,10" Padding="10"/><Button Content="Check password" Click="BreachClick" HorizontalAlignment="Left"/><TextBlock x:Name="BreachResult" TextWrapping="Wrap"/><TextBlock Text="Encrypted report archive" FontSize="18" Margin="0,20,0,8"/><TextBlock Text="Use a passphrase of at least 12 characters. Folder backups support up to 5,000 files and 60 MiB, exclude empty directories, and reject links. Store the archive on another device for independent protection." TextWrapping="Wrap"/><PasswordBox x:Name="ArchivePassword" MaxLength="1024" Width="360" HorizontalAlignment="Left" Margin="0,10" Padding="10"/><WrapPanel><Button Content="Export encrypted archive" Click="ArchiveClick"/><Button Content="Verify / restore archive to a file" Click="RestoreArchiveClick"/><Button Content="Back up selected folder" Click="FolderBackupClick"/><Button Content="Restore folder backup" Click="FolderRestoreClick"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Settings &amp; Recovery"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="Interactive monitoring" FontSize="22"/><CheckBox x:Name="UserMonitoring" Content="Monitor my Downloads, Documents file changes, clipboard address substitutions, and privacy settings" Checked="UserMonitoringChanged" Unchecked="UserMonitoringChanged" Margin="0,16"/><TextBlock Text="Clipboard contents stay in memory. File monitoring does not inspect file contents except files submitted to Microsoft Defender. Close the app to stop these user-session monitors." TextWrapping="Wrap"/><TextBlock Text="Service health and recovery" FontSize="22" Margin="0,25,0,10"/><TextBlock Text="Restore removes only journaled OTS changes that still match the values OTS applied. Later changes from other software are preserved." TextWrapping="Wrap"/><WrapPanel Margin="0,16"><Button Content="Restore previous configuration" Click="RestoreClick"/><Button Content="Open Windows Security" Click="SecurityClick"/></WrapPanel><TextBlock x:Name="SystemHealthText" TextWrapping="Wrap"/><TextBlock Text="Trusted software updates" FontSize="22" Margin="0,25,0,10"/><TextBlock Text="Automatic updates are unavailable until a trusted signing identity is provisioned. Downloading an installer alone does not establish authenticity. This build is unsigned." TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="About"><StackPanel Margin="24"><TextBlock Text="OTS Firewall79X" FontSize="26"/><TextBlock Text="Developed by Ohana Tech Solutions" Margin="0,10"/><TextBlock Text="Version 0.1.0 • incomplete development preview" Margin="0,10"/><TextBlock Text="This application combines Windows security observations, narrow reversible hardening, and local monitoring. It does not replace Microsoft Defender, guarantee protection on untrusted Wi-Fi, or make the computer immune to attack. The 79-layer specification remains the completion target." TextWrapping="Wrap"/><TextBlock Text="No advertising, registration, cloud account, or development tools are required to run the installed application." TextWrapping="Wrap" Margin="0,15"/></StackPanel></TabItem>
</TabControl></DockPanel></Window>
