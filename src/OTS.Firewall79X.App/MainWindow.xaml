<Window x:Class="OTS.Firewall79X.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OTS Firewall79X" Style="{StaticResource {x:Type Window}}" Icon="Assets/Brand.ico" Width="1380" Height="920" MinWidth="1000" MinHeight="700" UseLayoutRounding="True" SnapsToDevicePixels="True">
<DockPanel Background="#0F172A">
  <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="24,18" Background="#111C2F"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/><ColumnDefinition Width="215"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Image Source="Assets/Brand.png" Width="52" Height="52" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel VerticalAlignment="Center"><TextBlock Text="OTS Firewall79X" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="OHANA TECH SOLUTIONS" Style="{StaticResource Eyebrow}" Margin="0,4,0,0"/></StackPanel></StackPanel>
    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0,30,0"><TextBox x:Name="LayerSearch" TextChanged="LayerSearchChanged" AutomationProperties.Name="Search security layers" ToolTip="Search layers by name, category, evidence, or ID" Padding="34,12,12,12"/><TextBlock Text="⌕" FontSize="23" Foreground="{StaticResource Muted}" Margin="11,4,0,0" IsHitTestVisible="False"/><TextBlock Text="Search security layers…" Foreground="{StaticResource Muted}" Margin="35,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=LayerSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><Border CornerRadius="12" Background="#24405E" BorderBrush="#404E79A7" BorderThickness="1" Padding="12,5"><TextBlock Text="DEVELOPMENT PREVIEW" Foreground="#D0E2F9" FontSize="10" FontWeight="SemiBold"/></Border><TextBlock Text="v0.1.0  /  Local security workspace" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" Margin="0,7,0,0"/></StackPanel>
  </Grid></Border>
  <Border DockPanel.Dock="Bottom" Background="#111C2F" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="24,10"><TextBlock x:Name="StatusLine" Text="Connecting to local security service…" Foreground="{StaticResource Muted}" FontSize="12"/></Border>
  <TabControl x:Name="MainTabs">
    <TabItem Header="Overview"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,24">
      <TextBlock Text="Your security, at a glance." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Live observations. Clear capabilities. Changes you can undo." Foreground="{StaticResource Muted}" Margin="0,7,0,22"/>
      <Border Style="{StaticResource Card}" Padding="28"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Width="156" Height="170" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Ellipse Width="152" Height="152" Fill="#122D4E74" Stroke="#284E79A7" StrokeThickness="1"/>
          <Ellipse Width="126" Height="126" Stroke="#384E79A7" StrokeThickness="1"/>
          <Viewbox Width="100" Height="119"><Path x:Name="ShieldShape" Data="M 50,3 L 91,20 L 88,62 C 85,85 67,103 50,113 C 33,103 15,85 12,62 L 9,20 Z" Fill="#24405E" Stroke="#8BA8CD" StrokeThickness="2"><Path.Effect><DropShadowEffect Color="#4E79A7" BlurRadius="25" ShadowDepth="0" Opacity="0.3"/></Path.Effect></Path></Viewbox>
          <TextBlock Text="79" FontSize="32" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D8E8FA"/>
          <Border Background="#1E293B" BorderBrush="#4E79A7" BorderThickness="1" CornerRadius="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="10,3"><TextBlock x:Name="ShieldState" Text="CHECKING" Foreground="#B7CCE6" FontSize="10" FontWeight="SemiBold"/></Border>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="PROTECTION OVERVIEW" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="ProtectionText" Text="Service status unknown" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,10"/><TextBlock Text="This development preview provides limited protection. Review unavailable capabilities before relying on a feature." Foreground="#BCCDE2" MaxWidth="620" HorizontalAlignment="Left"/>
          <WrapPanel Margin="0,22,0,0"><Button x:Name="Toggle" Content="Turn ON" Click="ToggleClick" Background="#34587C" MinWidth="145" Padding="22,12" FontSize="15"/><Button Content="Pause 15 min" Click="PauseClick" Background="#182B43"/><Button Content="Refresh" Click="RefreshClick" Background="Transparent"/></WrapPanel>
        </StackPanel>
      </Grid></Border>
      <UniformGrid Columns="3" Margin="0,16,0,22">
        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="20"><StackPanel><TextBlock Text="CAPABILITY HEALTH" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="ScoreText" Text="— / 100" FontSize="34" Margin="0,10,0,5" FontWeight="Light"/><TextBlock x:Name="ConfidenceText" Text="Waiting for measured data" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="20"><StackPanel><TextBlock Text="CONFIRMED OTS BLOCKS" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="BlockedText" Text="—" FontSize="34" Margin="0,10,0,5" FontWeight="Light"/><TextBlock Text="Windows blocks are counted separately." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="SECURITY EVENTS" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="EventCountText" Text="—" FontSize="34" Margin="0,10,0,5" FontWeight="Light"/><TextBlock Text="Observed since service start." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,24"><StackPanel><TextBlock Text="SERVICE &amp; COVERAGE" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="ResourceText" Margin="0,9,0,6" FontFamily="Consolas" FontSize="12" Foreground="#BCCDE2"/><TextBlock x:Name="FeedText" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="HealthSummary" Foreground="#BCCDE2" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
      <DockPanel Margin="0,0,0,14"><TextBlock Text="Recent activity" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="LATEST 5 EVENTS" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
      <TextBlock x:Name="RecentEmpty" Text="No recent events reported. Activity appears here as it is observed." Foreground="{StaticResource Muted}" Margin="0,0,0,14"/><ItemsControl x:Name="RecentEvents" ItemTemplate="{StaticResource EventCard}"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Security layers"><DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,20"><TextBlock Text="Security layers" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="79 requirements. Actual evidence and declared limitations for every layer." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" Foreground="{StaticResource Muted}" FontSize="12" Text="Elapsed time is measured per check. Shared memory cannot be assigned accurately to individual layers."/><DataGrid x:Name="LayerGrid" SelectionChanged="LayerSelected"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45"/><DataGridTextColumn Header="Layer" Binding="{Binding Name}" Width="240"/><DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="100"/><DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="110"/><DataGridTextColumn Header="Evidence / limitation" Binding="{Binding Evidence}" Width="*"/><DataGridTextColumn Header="ms" Binding="{Binding Duration}" Width="60"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
    <TabItem Header="Threat activity"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,20"><TextBlock Text="Threat activity" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Observed security events, newest first. Indicators require context." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,24"><TextBlock x:Name="ActivityEmpty" Text="No events reported yet." Foreground="{StaticResource Muted}" Margin="0,0,0,16"/><ItemsControl x:Name="EventGrid" ItemTemplate="{StaticResource EventCard}"/></StackPanel></ScrollViewer></DockPanel></TabItem>
    <TabItem Header="Network"><DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,20"><TextBlock Text="Network connections" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="A live view of observed TCP connections and their owning processes." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><DataGrid x:Name="NetworkGrid"><DataGrid.Columns><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="75"/><DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="170"/><DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="*"/><DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
    <TabItem Header="Tools &amp; reports"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,24"><TextBlock Text="Tools &amp; reports" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Focused tools, run only when you choose." Foreground="{StaticResource Muted}" Margin="0,7,0,22"/>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Security reports &amp; checks" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Exports may contain process names, connection addresses, and file locations. Keep them private." Foreground="{StaticResource Muted}" Margin="0,10,0,18"/><WrapPanel><Button Content="Save security report" Click="ReportClick"/><Button Content="Scan folder for secrets" Click="SecretsClick"/><Button Content="Run self-check" Click="SelfTestClick"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Password breach check" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Optional · Only the first five characters of a SHA-1 hash are sent to Pwned Passwords. Your password is not saved." Foreground="{StaticResource Muted}" Margin="0,10,0,6"/><PasswordBox x:Name="BreachPassword" AutomationProperties.Name="Password to check for breaches" MaxLength="1024" Width="360" HorizontalAlignment="Left" Margin="0,10"/><Button Content="Check password" Click="BreachClick" HorizontalAlignment="Left"/><TextBlock x:Name="BreachResult"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Encrypted archives &amp; backups" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Use a passphrase of at least 12 characters. Folder backups support up to 5,000 files and 60 MiB, exclude empty directories, and reject links. Keep a copy on another device." Foreground="{StaticResource Muted}" Margin="0,10,0,6"/><PasswordBox x:Name="ArchivePassword" AutomationProperties.Name="Archive passphrase" MaxLength="1024" Width="360" HorizontalAlignment="Left" Margin="0,10"/><WrapPanel><Button Content="Export encrypted report" Click="ArchiveClick"/><Button Content="Restore report archive" Click="RestoreArchiveClick"/><Button Content="Back up folder" Click="FolderBackupClick"/><Button Content="Restore folder backup" Click="FolderRestoreClick"/></WrapPanel></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Settings &amp; recovery"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,24"><TextBlock Text="Settings &amp; recovery" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Your controls. Explicit permissions. Recoverable changes." Foreground="{StaticResource Muted}" Margin="0,7,0,22"/>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Interactive monitoring" FontSize="20" FontWeight="SemiBold"/><CheckBox x:Name="UserMonitoring" Checked="UserMonitoringChanged" Unchecked="UserMonitoringChanged" Margin="0,20,0,14"><TextBlock Text="Monitor my Downloads, Documents file changes, clipboard address substitutions, and privacy settings"/></CheckBox><TextBlock Text="Clipboard contents stay in memory. File monitoring does not inspect contents except files submitted to Microsoft Defender. These monitors stop when you close the app." Foreground="{StaticResource Muted}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Service health &amp; recovery" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Restore undoes OTS changes only where current values still match what OTS applied. Later changes from other software are preserved." Foreground="{StaticResource Muted}" Margin="0,10,0,18"/><WrapPanel><Button Content="Restore previous configuration" Click="RestoreClick"/><Button Content="Open Windows Security" Click="SecurityClick"/></WrapPanel><TextBlock x:Name="SystemHealthText" Foreground="#BCCDE2" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Trusted software updates" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Automatic updates are unavailable until a trusted signing identity is provisioned. This development build is unsigned." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="About"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Margin="0,0,12,24" Padding="40"><StackPanel><Image Source="Assets/Brand.png" Width="150" Height="150" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="OTS Firewall79X" FontSize="30" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock Text="Developed by Ohana Tech Solutions" Foreground="#8BA8CD" FontSize="16"/><TextBlock Text="Version 0.1.0 · incomplete development preview" Margin="0,20"/><TextBlock Text="Windows security observations, narrow reversible hardening, and local monitoring. This application does not replace Microsoft Defender, guarantee protection on untrusted Wi-Fi, or make a computer immune to attack. The 79-layer specification remains the completion target." Foreground="#BCCDE2"/><TextBlock Text="No advertising, registration, cloud account, or development tools are required to run the installed application." Foreground="{StaticResource Muted}" Margin="0,20,0,0"/></StackPanel></Border></ScrollViewer></TabItem>
  </TabControl>
</DockPanel></Window>
