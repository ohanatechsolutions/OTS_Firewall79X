<Window x:Class="OTS.Firewall79X.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OTS Firewall79X" Width="1220" Height="790" MinWidth="900" MinHeight="620" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14">
<DockPanel Margin="26">
<Border DockPanel.Dock="Top" Background="#142D45" CornerRadius="12" Padding="24" Margin="0,0,0,20"><Grid><StackPanel><TextBlock Text="OHANA TECH SOLUTIONS" Foreground="#68D8C3" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="OTS Firewall79X" Foreground="White" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Windows security • measured capabilities • reversible changes" Foreground="#B9CFDF" Margin="0,6,0,0"/></StackPanel><TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Text="DEVELOPMENT PREVIEW 0.1.0" Foreground="#F5CE7E" FontWeight="SemiBold"/></Grid></Border>
<TextBlock x:Name="StatusLine" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,12,0,0" Text="Connecting to local security service…"/>
<TabControl Background="White" BorderThickness="0">
<TabItem Header="Dashboard"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
<TextBlock Text="Protection overview" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ProtectionText" Text="Service status unknown" FontSize="20" Margin="0,12,0,4"/>
<TextBlock Text="Incomplete development build. Unavailable features and limitations are listed in Security Layers. Existing Windows security remains active independently." TextWrapping="Wrap" Foreground="#8D5B09" Margin="0,0,0,20"/>
<WrapPanel><Button x:Name="Toggle" Content="Turn ON" Click="ToggleClick" Background="#117A6B" Foreground="White" FontSize="21" MinWidth="210" Padding="24,16"/><Button Content="Pause for 15 minutes" Click="PauseClick"/><Button Content="Refresh status" Click="RefreshClick"/></WrapPanel>
<UniformGrid Columns="3" Margin="0,20,0,20"><StackPanel><TextBlock Text="CAPABILITY HEALTH" Foreground="#62788B"/><TextBlock x:Name="ScoreText" Text="— / 100" FontSize="32"/><TextBlock x:Name="ConfidenceText" TextWrapping="Wrap"/></StackPanel><StackPanel><TextBlock Text="CONFIRMED OTS BLOCKS" Foreground="#62788B"/><TextBlock x:Name="BlockedText" Text="—" FontSize="32"/><TextBlock Text="Observed blocks are not attributed to OTS." TextWrapping="Wrap"/></StackPanel><StackPanel><TextBlock Text="SECURITY EVENTS" Foreground="#62788B"/><TextBlock x:Name="EventCountText" Text="—" FontSize="32"/><TextBlock Text="Counters are since service start."/></StackPanel></UniformGrid>
<TextBlock x:Name="ResourceText" Margin="0,10"/><TextBlock x:Name="FeedText" TextWrapping="Wrap"/><TextBlock x:Name="HealthSummary" TextWrapping="Wrap" Margin="0,16"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Security Layers"><DockPanel Margin="12"><TextBox x:Name="LayerSearch" DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10" TextChanged="LayerSearchChanged" ToolTip="Filter by layer name, category, evidence, or ID"/><TextBlock DockPanel.Dock="Bottom" Margin="0,10" Text="Elapsed time is measured per check; shared memory cannot be accurately assigned to individual layers." TextWrapping="Wrap"/><DataGrid x:Name="LayerGrid" SelectionChanged="LayerSelected"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40"/><DataGridTextColumn Header="Layer" Binding="{Binding Name}" Width="260"/><DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="100"/><DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="100"/><DataGridTextColumn Header="Evidence / limitation" Binding="{Binding Evidence}" Width="*"/><DataGridTextColumn Header="ms" Binding="{Binding Duration}" Width="65"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="Threat Activity"><DataGrid x:Name="EventGrid" Margin="12"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="170"/><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/><DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="55"/><DataGridTextColumn Header="Event" Binding="{Binding Kind}" Width="210"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
<TabItem Header="Network"><DataGrid x:Name="NetworkGrid" Margin="12"><DataGrid.Columns><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/><DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="160"/><DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="*"/><DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
<TabItem Header="Tools &amp; Reports"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="Reports and user-authorized checks" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Exports may contain process names, connection addresses, and file locations. Keep them private." TextWrapping="Wrap" Margin="0,10,0,20"/><WrapPanel><Button Content="Save security report" Click="ReportClick"/><Button Content="Scan folder for exposed secrets" Click="SecretsClick"/><Button Content="Run local self-check" Click="SelfTestClick"/></WrapPanel><TextBlock Text="Password breach check (optional)" FontSize="18" Margin="0,20,0,8"/><TextBlock Text="Only the first five characters of a SHA-1 hash are sent to the Pwned Passwords range service. The password is not saved." TextWrapping="Wrap"/><PasswordBox x:Name="BreachPassword" MaxLength="1024" Width="360" HorizontalAlignment="Left" Margin="0,10" Padding="10"/><Button Content="Check password" Click="BreachClick" HorizontalAlignment="Left"/><TextBlock x:Name="BreachResult" TextWrapping="Wrap"/><TextBlock Text="Encrypted report archive" FontSize="18" Margin="0,20,0,8"/><TextBlock Text="Use a passphrase of at least 12 characters. Folder backups support up to 5,000 files and 60 MiB, exclude empty directories, and reject links. Store the archive on another device for independent protection." TextWrapping="Wrap"/><PasswordBox x:Name="ArchivePassword" MaxLength="1024" Width="360" HorizontalAlignment="Left" Margin="0,10" Padding="10"/><WrapPanel><Button Content="Export encrypted archive" Click="ArchiveClick"/><Button Content="Verify / restore archive to a file" Click="RestoreArchiveClick"/><Button Content="Back up selected folder" Click="FolderBackupClick"/><Button Content="Restore folder backup" Click="FolderRestoreClick"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Settings &amp; Recovery"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="Interactive monitoring" FontSize="22"/><CheckBox x:Name="UserMonitoring" Content="Monitor my Downloads, Documents file changes, clipboard address substitutions, and privacy settings" Checked="UserMonitoringChanged" Unchecked="UserMonitoringChanged" Margin="0,16"/><TextBlock Text="Clipboard contents stay in memory. File monitoring does not inspect file contents except files submitted to Microsoft Defender. Close the app to stop these user-session monitors." TextWrapping="Wrap"/><TextBlock Text="Service health and recovery" FontSize="22" Margin="0,25,0,10"/><TextBlock Text="Restore removes only journaled OTS changes that still match the values OTS applied. Later changes from other software are preserved." TextWrapping="Wrap"/><WrapPanel Margin="0,16"><Button Content="Restore previous configuration" Click="RestoreClick"/><Button Content="Open Windows Security" Click="SecurityClick"/></WrapPanel><TextBlock x:Name="SystemHealthText" TextWrapping="Wrap"/><TextBlock Text="Trusted software updates" FontSize="22" Margin="0,25,0,10"/><TextBlock Text="Automatic updates are unavailable until a trusted signing identity is provisioned. Downloading an installer alone does not establish authenticity. This build is unsigned." TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="About"><StackPanel Margin="24"><TextBlock Text="OTS Firewall79X" FontSize="26"/><TextBlock Text="Developed by Ohana Tech Solutions" Margin="0,10"/><TextBlock Text="Version 0.1.0 • incomplete development preview" Margin="0,10"/><TextBlock Text="This application combines Windows security observations, narrow reversible hardening, and local monitoring. It does not replace Microsoft Defender, guarantee protection on untrusted Wi-Fi, or make the computer immune to attack. The 79-layer specification remains the completion target." TextWrapping="Wrap"/><TextBlock Text="No advertising, registration, cloud account, or development tools are required to run the installed application." TextWrapping="Wrap" Margin="0,15"/></StackPanel></TabItem>
</TabControl></DockPanel></Window>
